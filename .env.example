DATABASE_URL=postgresql://postgres:password@localhost:5432/vacation_planner
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_PROVIDER=anthropic
VOYAGE_API_KEY=pa-your-voyage-key-here
EMBEDDING_MODEL=voyage-3.5-lite
EMBEDDING_DIMENSIONS=1024
WHISPER_MODEL=base
INJECTION_CLASSIFIER_ENABLED=true

# Datadog LLM Observability (optional). Create the key in Datadog > Organization Settings > API Keys.
DATADOG_ENABLED=false
DD_API_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=ai-vacation-planner
DD_ENV=dev
